class Solution {
public:
    vector<int> sortedSquares(vector<int>& nums) {
        // so we have to square and then sort the array
        int n = nums.size();
        //squaring each element
        for(int i=0;i<n;i++){
            nums[i] = nums[i]*nums[i];
        }
        //now we sort the array
        sort(nums.begin(),nums.end());
        return nums;

        
    }
};
